<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-movies-tables" author="doclivsey">

<!--   TODO: All LONG entities fields to BIGINT field in datasource     -->
        <createTable tableName="movies">
            <column name="id" type="int" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="external_id" type="int">
                <constraints unique="true"/>
            </column>
            <column name="name" type="varchar(500)"/>
            <column name="type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="year" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(500)"/>
            <column name="short_description" type="varchar(100)"/>
            <column name="status" type="varchar(25)">
                <constraints nullable="false"/>
            </column>
            <column name="rating" type="int">
                <constraints unique="true"/>
            </column>
            <column name="movie_length" type="int"/>
            <column name="rating_mpaa" type="varchar(10)"/>
            <column name="age_rating" type="int"/>
            <column name="logo_url" type="varchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="poster" type="int">
                <constraints unique="true"/>
            </column>
            <column name="backdrop" type="int">
                <constraints unique="true"/>
            </column>
            <column name="genres" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="countries" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="budget" type="int">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="fees" type="int">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <createTable tableName="external_ids">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="kinopoisk_HD" type="varchar(50)"/>
            <column name="imdb" type="varchar(25)"/>
            <column name="tmdb" type="int"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="movies"
                                 baseColumnNames="external_id"
                                 referencedTableName="external_ids"
                                 referencedColumnNames="id"
                                 constraintName="fk_movie_external_id"/>

        <createTable tableName="ratings">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="kp" type="float"/>
            <column name="imdb" type="float"/>
            <column name="tmdb" type="float"/>
            <column name="film_critics" type="float"/>
            <column name="russian_film_critics" type="float"/>
            <column name="await" type="float"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="movies"
                                 baseColumnNames="rating"
                                 referencedTableName="ratings"
                                 referencedColumnNames="id"
                                 constraintName="fk_movie_rating_id"/>

        <createTable tableName="short_images">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="url" type="varchar(512)"/>
            <column name="preview_url" type="varchar(512)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="movies"
                                 baseColumnNames="poster"
                                 referencedTableName="short_images"
                                 referencedColumnNames="id"
                                 constraintName="fk_movie_poster_id"/>
        <addForeignKeyConstraint baseTableName="movies"
                                 baseColumnNames="backdrop"
                                 referencedTableName="short_images"
                                 referencedColumnNames="id"
                                 constraintName="fk_movie_backdrop_id"/>

        <createTable tableName="seasons">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="movie_id" type="bigint">
                <constraints unique="true" nullable="true"/>
            </column>
            <column name="number" type="int"/>
            <column name="episodes_count" type="int"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="seasons"
                                 baseColumnNames="movie_id"
                                 referencedTableName="movies"
                                 referencedColumnNames="id"
                                 constraintName="fk_movie_seasons_info_id"/>
        
        <createTable tableName="currencies">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="value" type="bigint"/>
            <column name="currency" type="varchar(25)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="movies"
                                 baseColumnNames="budget"
                                 referencedTableName="currencies"
                                 referencedColumnNames="id"
                                 constraintName="fk_movie_budget_id"/>

        <createTable tableName="fees">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="world" type="bigint">
                <constraints unique="true"/>
            </column>
            <column name="russia" type="bigint">
                <constraints unique="true"/>
            </column>
            <column name="usa" type="bigint">
                <constraints unique="true"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="movies"
                                 baseColumnNames="fees"
                                 referencedTableName="fees"
                                 referencedColumnNames="id"
                                 constraintName="fk_movie_fees_id"/>
        <addForeignKeyConstraint baseTableName="fees"
                                 baseColumnNames="world"
                                 referencedTableName="currencies"
                                 referencedColumnNames="id"
                                 constraintName="fk_fees_world_id"/>
        <addForeignKeyConstraint baseTableName="fees"
                                 baseColumnNames="russia"
                                 referencedTableName="currencies"
                                 referencedColumnNames="id"
                                 constraintName="fk_fees_russia_id"/>
        <addForeignKeyConstraint baseTableName="fees"
                                 baseColumnNames="usa"
                                 referencedTableName="currencies"
                                 referencedColumnNames="id"
                                 constraintName="fk_fees_usa_id"/>

        <createTable tableName="similar_movies">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="movie_id" type="bigint">
                <constraints unique="true" nullable="true"/>
            </column>
            <column name="name" type="varchar(500)"/>
            <column name="en_name" type="varchar(500)"/>
            <column name="alternative_name" type="varchar(500)"/>
            <column name="type" type="varchar(50)"/>
            <column name="poster" type="bigint">
                <constraints unique="true"/>
            </column>
            <column name="rating" type="bigint">
                <constraints unique="true"/>
            </column>
            <column name="year" type="int"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="similar_movies"
                                 baseColumnNames="movie_id"
                                 referencedTableName="movies"
                                 referencedColumnNames="id"
                                 constraintName="fk_movie_similar_movie_id"/>
        <addForeignKeyConstraint baseTableName="similar_movies"
                                 baseColumnNames="poster"
                                 referencedTableName="short_images"
                                 referencedColumnNames="id"
                                 constraintName="fk_similar_movie_poster_id"/>
        <addForeignKeyConstraint baseTableName="similar_movies"
                                 baseColumnNames="rating"
                                 referencedTableName="ratings"
                                 referencedColumnNames="id"
                                 constraintName="fk_similar_movie_rating_id"/>
    </changeSet>
</databaseChangeLog>